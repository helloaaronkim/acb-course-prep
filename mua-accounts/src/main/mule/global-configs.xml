	http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
  <http:listener-config basePath="/" name="Listener-config">
    <http:listener-connection host="0.0.0.0" port="8081" readTimeout="300000"></http:listener-connection>
  </http:listener-config>
  <salesforce:sfdc-config name="Sfdc-config">
    <salesforce:oauth-client-credentials-connection>
      <salesforce:oauth-client-credentials clientId="3MVG9RcRPG0Y85buGx6wJENHvK4y714fhiXU6JIoy7ltQJ7oiLcBlgsph158xMBFA3pmtyUEk5FzCASzCSBgq" clientSecret="84612E1879FD6993D09683567AE19C5EA75AEC891E791AB882BFC840649CFD85" tokenUrl="https://trailsignup-1206b3e24ed4e1.my.salesforce.com/services/oauth2/token"></salesforce:oauth-client-credentials>
    </salesforce:oauth-client-credentials-connection>
  </salesforce:sfdc-config>
  <flow name="getAccounts">
    <http:listener allowedMethods="GET" config-ref="Listener-config" doc:id="tcfppr" doc:name="GET /accounts" path="/accounts">
      <http:response reasonPhrase="Success">
        <http:headers><![CDATA[#[output application/java
---
{
	"state" : "CA"
}]]]></http:headers>
      </http:response>
      </http:listener>
    <set-payload doc:id="yvhdtf" doc:name="Set payload" value="All accounts"></set-payload>
    <salesforce:query config-ref="Sfdc-config" doc:id="hyqxio" doc:name="Query">
      <salesforce:salesforce-query><![CDATA[SELECT Name, BillingStreet, BillingCity, BillingState, BillingPostalCode, BillingCountry FROM Account WHERE BillingState LIKE '%:state']]></salesforce:salesforce-query>
      <salesforce:parameters><![CDATA[#[output application/java
---
{
	"state" : "CA"
}]]]></salesforce:parameters>  
    </salesforce:query>
    <ee:transform doc:name="Transform Message" doc:id="sobimn" >
      <ee:message >
        <ee:set-payload doc:name="Set payload" doc:id="rguebh" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <logger doc:id="wozgvb" doc:name="Logger"></logger>
  </flow>
</mule>
