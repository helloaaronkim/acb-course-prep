<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:american-flights-training-api="http://www.mulesoft.org/schema/mule/american-flights-training-api" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd     http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd  http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd  http://www.mulesoft.org/schema/mule/american-flights-training-api http://www.mulesoft.org/schema/mule/american-flights-training-api/current/mule-american-flights-training-api.xsd  http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
	http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">
  <american-flights-training-api:config name="American_config" property_basePath="${american.basePath}" property_host="${american.host}" property_port="${american.port}" property_protocol="${american.protocol}">
    <american-flights-training-api:connection></american-flights-training-api:connection>
  </american-flights-training-api:config>
  <http:request-config basePath="${united.basePath}" name="Request-config" responseTimeout="300000">
    <http:request-connection host="${united.host}" port="${united.port}"></http:request-connection>
  </http:request-config>
  <wsc:config name="Delta-Config">
    <wsc:connection port="${delta.port}" service="${delta.service}" wsdlLocation="${delta.wsdl}">
    </wsc:connection>
  </wsc:config>
  <flow name="getAmericanFlights">
    
    <american-flights-training-api:get-flights client-id="${american.client_id}" client-secret="${american.client_secret}" config-ref="American_config" destination="#[vars.code]" doc:id="qcpomk" doc:name="Get flights"></american-flights-training-api:get-flights>
    <ee:transform doc:id="lldgtt" doc:name="JSON to [Flight]">
      <ee:message>
        <ee:set-payload doc:id="cxnoxu" doc:name="Set payload"><![CDATA[%dw 2.0
output application/java
---
payload map (Payload0, indexOfPayload0) -> {
  airlineName: Payload0.airlineName,
  availableSeats: Payload0.emptySeats,
  departureDate: Payload0.departureDate,
  destination: Payload0.destination,
  flightCode: Payload0.code,
  origination: Payload0.origin,
  planeType: Payload0.plane.planeType,
  price: Payload0.price
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <logger doc:id="dgpxdt" doc:name="Logger"></logger>
  </flow>
  <flow name="getUnitedFlights">
    
    <http:request config-ref="Request-config" doc:id="wujthl" doc:name="getFlights" path="/flights/{code}">
      <http:uri-params><![CDATA[#[output application/java
---
{
	"code" : vars.code
}]]]></http:uri-params>
    </http:request>
    <ee:transform doc:id="uknwoz" doc:name="JSON to [Flight]">
      <ee:message>
        <ee:set-payload doc:id="ewzgdk" doc:name="Set payload"><![CDATA[%dw 2.0
output application/java
---
payload.flights map (flight1, indexOfFlights1) -> {
  airlineName: flight1.airlineName ++ " Airlines",
  availableSeats: flight1.emptySeats,
  departureDate: flight1.departureDate,
  destination: flight1.destination,
  flightCode: flight1.code,
  origination: flight1.origin,
  planeType: flight1.planeType,
  price: flight1.price
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <logger doc:id="fhrdvo" doc:name="Logger"></logger>
  </flow>
  <flow name="getDeltaFlights">
    
    <wsc:consume config-ref="Delta-Config" doc:id="lakrzd" doc:name="Consume" operation="findFlight">
      <wsc:message>
        <wsc:body><![CDATA[#[%dw 2.0
output application/xml
---
  {
    findFlight: {
      destination: vars.code
    }
  }]]]></wsc:body>
      </wsc:message>
    </wsc:consume>
    <ee:transform doc:id="bysqxg" doc:name="JSON to java">
      <ee:message>
        <ee:set-payload doc:id="zvbhts" doc:name="Set payload"><![CDATA[%dw 2.0
output application/java
---
payload.body.findFlightResponse.*return map {
  airlineName: $.airlineName default "" ++ " Airlines",
  availableSeats: $.emptySeats,
  departureDate: $.departureDate,
  destination: $.destination,
  flightCode: $.code,
  origination: $.origin,
  planeType: $.planeType,
  price: $.price
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <logger doc:id="fbyhlc" doc:name="Logger"></logger>
  </flow>
  <sub-flow doc:id="shdtkm" name="setVars">
    <set-variable doc:id="nctmiz" doc:name="setCode" value="#[attributes.queryParams.code]" variableName="code"></set-variable>
    <set-variable doc:name="Set variable" doc:id="zcbfcd" variableName="airline" value="#[attributes.queryParams.airline]"/>
  </sub-flow>
  <flow name="getAllAirlineFlights">
    
    <scatter-gather doc:name="Scatter gather" doc:id="cddudn">
      <route>
        <flow-ref doc:name="american" name="getAmericanFlights"/>
      </route>
      <route>
        <flow-ref doc:name="united" name="getUnitedFlights"/>
      </route>
      <route doc:name="Route">
        <flow-ref doc:name="delta" name="getDeltaFlights"/>
          
      </route>
        
    </scatter-gather>
        <ee:transform doc:name="Transform Message" doc:id="hzxchy" >
            <ee:message >
                <ee:set-payload doc:name="Set payload" doc:id="dchcwy" ><![CDATA[%dw 2.0
output application/java
---
flatten(payload..payload)]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    <logger doc:name="Logger" doc:id="ntsuez"/></flow>
<flow name="getFlights">
    <http:listener doc:name="Listener" doc:id="lwsoev" path="/flights" config-ref="mua-flights-api-httpListenerConfig" allowedMethods="GET"/>
    <flow-ref doc:name="Flow-ref" name="setVars"/>
    <validation:is-true doc:name="Is true" doc:id="abbkox" expression="#[['SFO','LAX','CLE','PDX','PDF'] contains vars.code]" message="#['Invalid destination ' ++ (vars.code default 'undefined')]"/>
    <choice doc:name="Choice" doc:id="ukhxew">
        
    <when doc:name="american" expression='#[vars.airline == "american"]'>
        <flow-ref doc:name="american" name="getAmericanFlights"/></when>
      <when doc:name="united" expression="#[vars.airline == 'united']">
        <flow-ref doc:name="united" name="getUnitedFlights"/>
          
      </when>
      <when doc:name="delta" expression="#[vars.airline == 'delta']">
        <flow-ref doc:name="delta" name="getDeltaFlights"/>
          
      </when>
      <otherwise>
        <flow-ref doc:name="all" name="getAllAirlineFlights"/>
      </otherwise></choice>
    <ee:transform doc:name="Transform Message" doc:id="qeusmc" >
      <ee:message >
        <ee:set-payload doc:name="Set payload" doc:id="rygkaq" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <logger doc:name="Logger" doc:id="qbstsc"/></flow>
</mule>
